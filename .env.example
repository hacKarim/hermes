# OpenAI
# Get your key: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=
# OPENAI_SESSION_TOKEN=
# OPENAI_PROXY_URL=
OPENAI_MAX_TOKENS=2048
# OPENAI_MODEL=gpt-4

# File reading: dir | git
READ_TYPE=git
READ_GIT_STATUS=A,R,M
READ_FILES_ROOT_NAME=example
READ_FILE_EXTENSIONS=.ts,.tsx,.js,.jsx

# Test generation
TEST_FILE_TYPE=test
TEST_FILE_DIR_NAME=__test__

# Translate (i18n keys)
TRANSLATE=fr,es

# Optional webhook for review reports
# REVIEW_REPORT_WEBHOOK=
