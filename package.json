{
  "name": "hermes",
  "version": "0.0.6",
  "description": "AI-powered CLI for code review, test generation, scaffolding and i18n translation using the OpenAI API.",
  "main": "./build/index.js",
  "type": "module",
  "source": "./src/index.ts",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup && cpy prompt build",
    "clean": "del build",
    "prebuild": "run-s clean",
    "predev": "run-s clean && cpy prompt build",
    "pretest": "run-s build",
    "pre-commit": "lint-staged",
    "prepare": "husky install",
    "prepublishOnly": "run-s test",
    "format": "prettier --write ./src",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "files": [
    "build",
    "bin"
  ],
  "bin": {
    "hermes": "./bin/cli.js"
  },
  "engines": {
    "node": ">=14"
  },
  "dependencies": {
    "@babel/generator": "^7.21.3",
    "@babel/parser": "^7.21.3",
    "@babel/traverse": "^7.21.3",
    "abort-controller": "^3.0.0",
    "chalk": "^5.2.0",
    "chatgpt": "^5.1.4",
    "commander": "^10.0.0",
    "dotenv": "^16.0.3",
    "inquirer": "^9.1.5",
    "isomorphic-fetch": "^3.0.0",
    "ora": "^5.4.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "ai",
    "openai",
    "code-review",
    "unit-test",
    "codegen",
    "cli"
  ],
  "devDependencies": {
    "@jest/types": "^30.5.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "cpy-cli": "^7.0.0",
    "del-cli": "^8.0.1",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
  }
}
